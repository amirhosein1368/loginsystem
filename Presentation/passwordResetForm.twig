
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wachtwoord Resetten</title>

    <link rel="stylesheet" href="Resources/style.css">
</head>
<body>

    <div class="container">

        <h1>Wachtwoord Resetten</h1>

        <?php //if (!empty($errors)) : ?>
        {% if errors is defined %}
            <div class="error-box">

                <?php //if (isset($errors["email_empty"])) : ?>
                {% if errors.email_empty is defined %}
                    <p>Gebruikersnaam is verplicht.</p>
                {% endif %}

                <?php //if (isset($errors["password_empty"])) : ?>
                {% if errors.password_empty is defined %}
                    <p>Nieuw wachtwoord is verplicht.</p>
                {% endif %}

                <?php //if (isset($errors["confirmPassword_empty"])) : ?>
                {% if errors.confirmPassword_empty is defined %}
                    <p>Bevestig wachtwoord is verplicht.</p>
                {% endif %}

                <?php //if (isset($errors["passwords_notMatch"])) : ?>
                {% if errors.passwords_notMatch is defined %}
                    <p>Wachtwoorden komen niet overeen.</p>
                {% endif %}
                
                {% if errors.userBestaatNiet is defined and errors.userBestaatNiet is same as(true) %}
                    <p>Gebruiker niet gevonden.</p>
                {% endif %}
            </div>

        {% endif %}

        <?php //if (isset($_GET["msg"]) && 'passwordIsReste' === $_GET["msg"]) : ?>
        {% if errors.passwordIsReste is defined and errors.passwordIsReste is same as(true) %}
            <div class="success-box">
                <p>Wachtwoord succesvol aangepast.</p>
            </div>
        {% endif %}
        <?php //endif; ?>

        <form method="post" action="passwordReset.php?action=reset" novalidate>

            <div class="input-group">
                <input
                    type="text"
                    name="email"
                    placeholder="Email"
                    value="{{email|default('') }}"
                    required
                >
            </div>

            <div class="input-group">
                <input
                    type="password"
                    name="password"
                    placeholder="Nieuw wachtwoord"
                    value="{{password|default('') }}"
                    required
                >
            </div>

            <div class="input-group">
                <input
                    type="password"
                    name="confirmPassword"
                    value="{{confirmPassword|default('') }}"
                    placeholder="Bevestig nieuw wachtwoord"
                    required
                >
            </div>

            <input
                type="submit"
                value="Reset Wachtwoord"
                class="btn"
            >

        </form>

        <div class="bottom-text">
            Terug naar
            <a href="aanmelden.php">
                Aanmelden
            </a>
        </div>

    </div>

</body>
</html>